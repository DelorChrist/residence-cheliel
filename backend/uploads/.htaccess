# ============================================================
# Sécurité Dossier Uploads — Résidence Cheliel
# Désactiver toute exécution de script dans les uploads (RCE Protection)
# ============================================================
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh|bash|html|htm|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    AddType video/mp4 .mp4 .m4v
    AddType video/webm .webm
    AddType video/ogg .ogv
    AddType video/quicktime .mov
</IfModule>

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header always set Access-Control-Allow-Headers "*"
    Header always set Cross-Origin-Resource-Policy "cross-origin"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
