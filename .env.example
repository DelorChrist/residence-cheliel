# Copier ce fichier en .env et remplir les valeurs

# Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_ici

# SMS Edge Function (Supabase)
# Déployez la function send-reservation-sms puis renseignez ces secrets côté Supabase
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1234567890
# RESIDENCE_NAME=Résidence Cheliel

# Email Edge Function (SendGrid)
# Déployez la function send-reservation-email puis renseignez ces secrets côté Supabase
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESIDENCE_EMAIL_FROM=reservations@votre-domaine.com
