# ==============================================================================
# Configuration du Déploiement Direct o2switch (FTP / FTPS) — Résidence Cheliel
# ==============================================================================

# Hôte FTP : votre nom de domaine ou l'adresse de votre serveur o2switch
# Exemples : residencescheliel.com, ftp.residencescheliel.com, ou xx.o2switch.net
FTP_HOST=residencescheliel.com

# Identifiant cPanel ou compte FTP o2switch
FTP_USER=fuke3268

# Mot de passe du compte cPanel ou du compte FTP
FTP_PASSWORD=VotreMotDePasse

# Port FTP (21 par défaut)
FTP_PORT=21

# Sécurité : true pour FTPS sécurisé (TLS), false pour FTP simple
FTP_SECURE=true

# Dossier distant du Frontend sur le serveur
# "residencescheliel.com" pour le domaine principal sur o2switch
FTP_FRONTEND_REMOTE_DIR=residencescheliel.com

# Dossier distant du Backend Node.js
FTP_BACKEND_REMOTE_DIR=api.residencescheliel.com
